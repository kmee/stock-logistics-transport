<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View for TMS Order Stops -->
    <record id="tms_order_stop_tree" model="ir.ui.view">
        <field name="name">tms.order.stop.tree</field>
        <field name="model">tms.order.stop</field>
        <field name="arch" type="xml">
            <list string="Delivery Stops" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="partner_id" />
                <field name="weight" />
                <field name="weight_uom_id" />
                <field name="volume" />
                <field name="volume_uom_id" />
                <field name="unloading_time" />
                <field name="scheduled_date" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="address_complete" />
                <field name="state" />
            </list>
        </field>
    </record>

    <!-- Form View for TMS Order Stops -->
    <record id="tms_order_stop_form" model="ir.ui.view">
        <field name="name">tms.order.stop.form</field>
        <field name="model">tms.order.stop</field>
        <field name="arch" type="xml">
            <form string="Delivery Stop">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" />
                            <field name="sequence" />
                            <field name="partner_id" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="scheduled_date" />
                            <field name="unloading_time" />
                        </group>
                    </group>
                    <group string="Weight and Volume">
                        <group>
                            <field name="weight" />
                            <field name="weight_uom_id" />
                        </group>
                        <group>
                            <field name="volume" />
                            <field name="volume_uom_id" />
                        </group>
                    </group>
                    <group string="Location">
                        <field name="latitude" />
                        <field name="longitude" />
                        <field name="address_complete" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for TMS Order Stops -->
    <record id="tms_order_stop_search" model="ir.ui.view">
        <field name="name">tms.order.stop.search</field>
        <field name="model">tms.order.stop</field>
        <field name="arch" type="xml">
            <search string="Delivery Stops">
                <field name="partner_id" />
                <field name="order_id" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="scheduled"
                    string="Scheduled"
                    domain="[('state', '=', 'scheduled')]"
                />
                <filter
                    name="delivered"
                    string="Delivered"
                    domain="[('state', '=', 'delivered')]"
                />
                <filter
                    name="skipped"
                    string="Skipped"
                    domain="[('state', '=', 'skipped')]"
                />
            </search>
        </field>
    </record>

    <!-- Leaflet Map View for TMS Order Stops -->
    <record id="tms_order_stop_leaflet_map" model="ir.ui.view">
        <field name="name">tms.order.stop.leaflet_map</field>
        <field name="model">tms.order.stop</field>
        <field name="arch" type="xml">
            <leaflet_map
                field_latitude="latitude"
                field_longitude="longitude"
                field_title="display_name"
                field_address="address_complete"
                default_zoom="12"
                max_zoom="19"
            >
                <field name="latitude" />
                <field name="longitude" />
                <field name="display_name" />
                <field name="address_complete" />
                <field name="partner_id" />
                <field name="order_id" />
                <field name="sequence" />
                <field name="weight" />
                <field name="volume" />
                <field name="state" />
            </leaflet_map>
        </field>
    </record>

    <!-- Action for TMS Order Stops -->
    <record id="action_tms_order_stop" model="ir.actions.act_window">
        <field name="name">Delivery Stops</field>
        <field name="res_model">tms.order.stop</field>
        <field name="view_mode">list,form,leaflet_map</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new delivery stop
                </p>
        </field>
    </record>

    <!-- Add leaflet_map view to action -->
    <record
        id="action_tms_order_stop_view_leaflet_map"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="3" />
        <field name="view_mode">leaflet_map</field>
        <field name="view_id" ref="tms_order_stop_leaflet_map" />
        <field name="act_window_id" ref="action_tms_order_stop" />
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_tms_order_stop"
        name="Delivery Stops"
        parent="tms.root"
        action="action_tms_order_stop"
        sequence="30"
    />
</odoo>
