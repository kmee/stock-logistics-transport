    <!-- Demo TMS Team for Route Optimizer -->
    <record id="demo_team_route_optimizer" model="tms.team">
        <field name="name">Team Route Optimizer - São Paulo</field>
        <field
            name="allowed_vehicle_type_ids"
            eval="[(6, 0, [
            ref('tms_vehicle_capacity.fleet_vehicle_type_van'),
            ref('tms_vehicle_capacity.fleet_vehicle_type_vuc')
        ])]"
        />
        <field name="default_origin_location_id" ref="demo_depot_location_optimizer" />
        <field
            name="default_destination_location_id"
            ref="demo_depot_location_optimizer"
        />
    </record>

    <!-- Demo Vehicle Brand and Model -->
    <record id="demo_brand_optimizer" model="fleet.vehicle.model.brand">
        <field name="name">Optimizer Brand</field>
    </record>

    <record id="demo_model_optimizer_van" model="fleet.vehicle.model">
        <field name="name">Van Model Optimizer</field>
        <field name="brand_id" ref="demo_brand_optimizer" />
        <field name="vehicle_type">car</field>
    </record>

    <!-- Demo Vehicles for Route Optimizer -->
    <record id="demo_vehicle_optimizer_van_1" model="fleet.vehicle">
        <field name="license_plate">OPT-VAN-001</field>
        <field name="model_id" ref="demo_model_optimizer_van" />
        <field
            name="vehicle_type_id"
            ref="tms_vehicle_capacity.fleet_vehicle_type_van"
        />
        <field name="weight_capacity">500</field>
        <field name="volume_capacity">10</field>
        <field name="cost_per_km">2.50</field>
        <field name="minimum_trip_cost">50.00</field>
        <field name="tms_team_id" ref="demo_team_route_optimizer" />
    </record>

