        <field name="order_id" ref="demo_tms_order_optimizer_1" />
        <field name="sequence">10</field>
        <field name="partner_id" ref="demo_partner_optimizer_1" />
        <field name="weight">50.0</field>
        <field name="weight_uom_id" ref="uom.product_uom_kgm" />
        <field name="volume">1.0</field>
        <field name="volume_uom_id" ref="uom.product_uom_cubic_meter" />
        <field name="unloading_time">30</field>
        <field
            name="scheduled_date"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"
        />
        <field name="state">draft</field>
    </record>

